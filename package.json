{
  "name": "zxui-cn",
  "version": "0.1.8",
  "description": "A Vue 3 UI component library",
  "keywords": [
    "vue3",
    "components",
    "ui-library",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/zxui-cn.umd.js",
  "module": "./dist/zxui-cn.es.js",
  "types": "./dist/zxui-cn.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/zxui-cn.d.ts",
      "import": "./dist/zxui-cn.es.js",
      "require": "./dist/zxui-cn.umd.js"
    },
    "./style.css": {
      "import": "./dist/style.css",
      "require": "./dist/style.css"
    },
    "./dist/*": "./dist/*"
  },
  "style": "./dist/style.css",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky",
    "example:dev": "vite examples --config examples/vite.config.ts",
    "example:build": "vite build examples --config examples/vite.config.ts",
    "example:preview": "vite preview examples --config examples/vite.config.ts"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.7",
    "vite-plugin-md": "^0.21.5",
    "vue-router": "^4.0.0",
    "xml-formatter": "^3.6.5"
  },
  "peerDependencies": {
    "vue": "^3.4.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/node": "^22.13.14",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vue/runtime-core": "^3.4.15",
    "@vue/runtime-dom": "^3.4.15",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "husky": "^9.0.0",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.0.0",
    "markdown-it-attrs": "^4.3.1",
    "prettier": "^3.0.0",
    "sass": "^1.86.0",
    "sass-embedded": "^1.86.0",
    "typescript": "^5.8.2",
    "vite": "^4.5.0",
    "vite-plugin-dts": "^4.5.3",
    "vitepress": "^1.6.3",
    "vitest": "^1.0.0",
    "vue": "^3.4.15",
    "vue-tsc": "^2.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  }
}
